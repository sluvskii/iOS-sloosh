{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".validate": "!newData.hasChild('isBanned') || data.child('isBanned').val() == newData.child('isBanned').val() || root.child('admins').child(auth.uid).val() == true"
      }
    },

    "user_profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },

    "userTags": {
      ".read": "auth != null",
      "$tag": {
        ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || (data.exists() && (data.val() == auth.uid || root.child('admins').child(auth.uid).val() == true)))"
      }
    },

    "channels": {
      ".read": "auth != null",
      "$channelId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() == auth.uid) || (data.exists() && (data.child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)))",
        "subscriberCount": {
          ".write": "auth != null && data.parent().exists()"
        },
        "lastPostText": {
          ".write": "auth != null && (data.parent().child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)"
        },
        "lastPostTimestampMs": {
          ".write": "auth != null && (data.parent().child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)"
        }
      }
    },

    "public_channels": {
      ".read": "auth != null",
      "$channelId": {
        ".write": "auth != null && ((!data.exists() && (root.child('channels').child($channelId).child('ownerId').val() == auth.uid || newData.child('ownerId').val() == auth.uid)) || (data.exists() && (root.child('channels').child($channelId).child('ownerId').val() == auth.uid || data.child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)))",
        "subscriberCount": {
          ".write": "auth != null && data.parent().exists()"
        },
        "lastPostText": {
          ".write": "auth != null && (data.parent().child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)"
        },
        "lastPostTimestampMs": {
          ".write": "auth != null && (data.parent().child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)"
        },
        "posts": {
          "$postId": {
            ".write": "auth != null && (root.child('channels').child($channelId).child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)",
            "viewsCount": {
              ".write": "auth != null && data.parent().exists()"
            },
            "reactions": {
              "$uid": {
                ".write": "auth != null && ($uid == auth.uid || root.child('admins').child(auth.uid).val() == true)"
              }
            }
          }
        }
      }
    },

    "channelTags": {
      ".read": "auth != null",
      "$tag": {
        ".write": "auth != null && ((!data.exists() && root.child('channels').child(newData.val()).child('ownerId').val() == auth.uid) || (data.exists() && (root.child('channels').child(data.val()).child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)))"
      }
    },

    "channel_posts": {
      "$channelId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('channels').child($channelId).child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)",
        "$postId": {
          "viewsCount": {
            ".write": "auth != null && data.parent().exists()"
          },
          "reactions": {
            "$uid": {
              ".write": "auth != null && ($uid == auth.uid || root.child('admins').child(auth.uid).val() == true)"
            }
          }
        }
      }
    },

    "channel_subscribers": {
      "$channelId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
        }
      }
    },

    "user_channel_subscriptions": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null && ($chatId.contains(auth.uid) || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && ($chatId.contains(auth.uid) || root.child('admins').child(auth.uid).val() == true)"
      }
    },

    "user_chats": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        "$chatId": {
          ".write": "auth != null && ($uid == auth.uid || $chatId.contains(auth.uid) || root.child('admins').child(auth.uid).val() == true)"
        }
      }
    },

    "active_sessions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$sessionId": {
        ".write": "(auth != null && ($sessionId == 'usr_' + auth.uid || root.child('admins').child(auth.uid).val() == true)) || ($sessionId.beginsWith('guest_') && newData.child('userId').val() == null)"
      }
    },

    "media_stats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "pairing": {
        "$codeHash": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || !newData.exists() || data.child('status').val() == 'pending' || data.child('expiresAt').val() < now)",
          ".validate": "newData.hasChildren(['status', 'expiresAt']) && (newData.child('status').val() == 'pending' || (data.child('status').val() == 'pending' && newData.child('uid').val() == auth.uid))",
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'granted')"
          },
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "ct": {
            ".validate": "newData.isString() && newData.val().length <= 2048"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "expiresAt": {
            ".validate": "newData.isNumber()"
          },
          "grantedAt": {
            ".validate": "newData.isNumber()"
          }
        }
      },
      "media_artwork_overrides": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      },
      "clips": {
        ".read": true,
        "$clipId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() == auth.uid) || (data.exists() && (data.child('authorId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)))",
          "likesCount": {
            ".write": "auth != null && data.parent().exists()"
          },
          "viewsCount": {
            ".write": "auth != null && data.parent().exists()"
          },
          "commentsCount": {
            ".write": "auth != null && data.parent().exists()"
          }
        }
      },
      "clips_likes": {
        ".read": true,
        "$clipId": {
          ".write": "auth != null && (root.child('media_stats').child('clips').child($clipId).child('authorId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true || !root.child('media_stats').child('clips').child($clipId).exists())",
          "$userId": {
            ".write": "auth != null && ($userId == auth.uid || root.child('admins').child(auth.uid).val() == true)"
          }
        }
      },
      "clips_views": {
        ".read": true,
        "$clipId": {
          ".write": "auth != null && (root.child('media_stats').child('clips').child($clipId).child('authorId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true || !root.child('media_stats').child('clips').child($clipId).exists())",
          "$userId": {
            ".write": "auth != null && ($userId == auth.uid || root.child('admins').child(auth.uid).val() == true)"
          }
        }
      },
      "clips_comments": {
        ".read": true,
        "$clipId": {
          ".write": "auth != null && (root.child('media_stats').child('clips').child($clipId).child('authorId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true || !root.child('media_stats').child('clips').child($clipId).exists())",
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() == auth.uid) || (data.exists() && (data.child('authorId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)))"
          }
        }
      },
      "$mediaKey": {
        ".read": "$mediaKey != 'pairing'",
        ".write": "auth != null && $mediaKey != 'pairing' && $mediaKey != 'media_artwork_overrides' && $mediaKey != 'clips' && $mediaKey != 'clips_likes' && $mediaKey != 'clips_views' && $mediaKey != 'clips_comments'",
        "title": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "posterUrl": { ".validate": "newData.isString() && newData.val().length <= 2048" },
        "totalPlays": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "lastPlayedMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "translations": {
          "$voice": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": false
      }
    },

    "media_comments": {
      ".read": true,
      "$mediaKey": {
        ".indexOn": ["createdAtMs"],
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() == auth.uid) || (data.exists() && (data.child('authorId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)))",
          ".validate": "newData.hasChildren(['authorId', 'authorName', 'text', 'createdAtMs']) && newData.child('text').isString() && newData.child('text').val().length <= 4000 && newData.child('authorName').isString() && newData.child('authorName').val().length <= 200",
          "likedBy": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    },

    "media_comment_reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$commentId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },

    "watch_parties": {
      "$partyId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() == auth.uid) || (data.exists() && (data.child('hostUid').val() == auth.uid || data.child('guestUid').val() == auth.uid || (!data.child('guestUid').exists() && newData.child('guestUid').val() == auth.uid))))"
      }
    },

    "global_stats": {
      ".read": true,
      "translations": {
        ".write": "auth != null",
        "$voice": { ".validate": "newData.isNumber() && newData.val() >= 0" }
      }
    }
  }
}
