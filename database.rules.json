{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "user_profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "userTags": {
      ".read": "auth != null",
      "$tag": {
        ".write": "auth != null"
      }
    },

    "channels": {
      ".read": "auth != null",
      "$channelId": {
        ".write": "auth != null"
      }
    },

    "public_channels": {
      ".read": "auth != null",
      "$channelId": {
        ".write": "auth != null"
      }
    },

    "channelTags": {
      ".read": "auth != null",
      "$tag": {
        ".write": "auth != null"
      }
    },

    "channel_posts": {
      "$channelId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "channel_subscribers": {
      "$channelId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },

    "user_channel_subscriptions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "user_chats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "active_sessions": {
      ".read": "auth != null",
      "$sessionId": {
        ".write": true
      }
    },

    "media_stats": {
      ".read": true,
      "$mediaKey": {
        ".write": true
      }
    },

    "media_comments": {
      ".read": true,
      "$mediaKey": {
        ".indexOn": ["createdAtMs"],
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() == auth.uid) || (data.exists() && data.child('authorId').val() == auth.uid))",
          ".validate": "newData.hasChildren(['authorId', 'authorName', 'text', 'createdAtMs']) && newData.child('text').isString()",
          "likedBy": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    },

    "media_comment_reports": {
      ".read": "auth != null",
      "$commentId": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },

    "global_stats": {
      ".read": true,
      ".write": true
    }
  }
}
